projection;
strict ( 2 );

// ─────────────────────────────────────────────────────────────
// PROJECTION BEHAVIOR for ROOT ENTITY – Purchase Order Header
// ─────────────────────────────────────────────────────────────
define behavior for ZC_PO_RAP_H alias PurchaseOrderHeader
{
  use create;
  use update;
  use delete;

  use association _Items { create; update; delete; }
}

// ─────────────────────────────────────────────────────────────
// PROJECTION BEHAVIOR for CHILD ENTITY – Purchase Order Item
// ─────────────────────────────────────────────────────────────
define behavior for ZC_PO_RAP_I alias PurchaseOrderItem
{
  use update;
  use delete;
}