@EndUserText.label : 'Purchase Order Item'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zpo_rap_i {

  key client          : abap.clnt not null;

  @AbapCatalog.foreignKey.keyType : #NOT_SPECIFIED
  @AbapCatalog.foreignKey.screenCheck : false
  key po_id           : abap.numc(10) not null
    with foreign key [0..*,1] zpo_rap_h
      where client = zpo_rap_i.client
        and po_id  = zpo_rap_i.po_id;

  key po_item         : abap.numc(5) not null;

  material            : abap.char(18);
  quantity            : abap.dec(13,3);
  currency_code       : abap.cuky;

  @Semantics.amount.currencyCode : 'currency_code'
  unit_price          : abap.curr(15,2);

  @Semantics.amount.currencyCode : 'currency_code'
  net_amount          : abap.curr(15,2);

  created_by          : abp_creation_user;
  created_at          : abp_creation_tstmpl;
  last_changed_by     : abp_locinst_lastchange_user;
  last_changed_at     : abp_locinst_lastchange_tstmpl;

}